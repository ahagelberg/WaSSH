{
  "name": "wassh",
  "version": "1.1.1",
  "description": "WaSSH — advanced multi-tab SSH client",
  "main": "./out/main/index.js",
  "author": "Andreas Hagelberg",
  "license": "MIT",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "setup-native": "node scripts/setup-native.js",
    "postinstall": "node scripts/setup-native.js",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.9",
    "mqtt": "^5.15.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "serialport": "^13.0.0",
    "ssh2": "^1.16.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ssh2": "^1.15.4",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.13.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.wassh.app",
    "productName": "WaSSH",
    "publish": {
      "provider": "github",
      "owner": "ahagelberg",
      "repo": "WaSSH",
      "releaseType": "release"
    },
    "directories": {
      "output": "release"
    },
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "out/**/*",
      "!node_modules/@fontsource/**",
      "!node_modules/@xterm/**",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/scheduler/**",
      "!node_modules/**/*.{iobj,ipdb,pdb,lib,obj,exp,ilk,tlog}",
      "!node_modules/**/build/{Release,Debug}/obj/**",
      "!node_modules/**/prebuilds/android-*/**",
      "!node_modules/**/prebuilds/win32-arm64/**",
      "!node_modules/**/prebuilds/win32-ia32/**"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "res/WaSSH program icon.png",
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "res/WaSSH.icns",
      "artifactName": "WaSSH-${version}-mac-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "dmg": {
      "artifactName": "WaSSH-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "artifactName": "WaSSH-${version}-linux-${arch}.${ext}",
      "category": "Development"
    },
    "portable": {
      "artifactName": "WaSSH-Portable-${version}.${ext}"
    },
    "nsis": {
      "artifactName": "WaSSH-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
